{
  "model_name": "U-LASTDE",
  "output_root": "data/processed_dataset",
  "save_root": "runs",
  "threshold_mode": "threshold",
  "threshold": [0.2, 0.09],
  "n_days": 5,
  "time_steps": 60,
  "seq_length": 60,
  "n_segments": 20,
  "n_nodes": 20,
  "n_lanes": 7,
  "n_features": 3,
  "n_anomaly_types": 2,
  "output_dim": 2,
  "horizon": 60,
  "forecast_dim": 256,
  "random_seed": 42,
  "normalization": "standardization",
  "use_all_days": true,
  "abnormal_day_index": 0,
  "lane_fusion_type": "attention",
  "lane_cnn_channels": [32, 64],
  "lane_cnn_kernel": 5,
  "lane_dropout": 0.1,
  "lane_num_heads": 4,
  "lane_num_layers": 2,
  "deepsets_pool": "mean",
  "day_dropout": 0.1,
  "st_dropout": 0.1,
  "num_encoder_blocks": 2,
  "activation": "gelu",
  "temporal_variant": "inception",
  "temporal_kernel": 3,
  "temporal_kernel_set": [3, 5],
  "spatial_mode": "attnA",
  "spatial_K": 1,
  "spatial_num_layers": 1,
  "spatial_num_heads": 4,
  "spatial_clamp_val": 6.0,
  "spatial_eps": 0.000001,
  "batch_size": 32,
  "epochs": 200,
  "learning_rate": 0.001,
  "weight_decay": 0.0000001,
  "grad_clip": null,
  "loss_type": "mse",
  "device": "auto",
  "num_workers": 0,
  "pin_memory": true,
  "use_dataparallel": false
}
